enum Role {
  CLIENTE
  GERENTE
  @@map("role")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  cpf       String   @unique
  name      String
  email     String   @unique
  password  String
  role      Role    @default(CLIENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
